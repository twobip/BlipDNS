[Unit]
Description=BlipDNS Controller - Unifi-style fleet management console
Documentation=https://github.com/twobip/BlipDNS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blipc
Group=blipc
ExecStart=/usr/local/bin/blipc -config /etc/blipc/blipc.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_BIND_SERVICE
# No CapabilityBoundingSet restriction: the blipc user elevates to the pinned
# /usr/local/sbin/blipc-install helper via sudo (narrow sudoers rule), which
# needs CAP_SETGID/CAP_SETUID available.
# NoNewPrivileges must stay OFF for the same reason.
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/blipc /var/lib/blipc /var/cache/blipc-update /usr/local/bin
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=blipc

[Install]
WantedBy=multi-user.target
